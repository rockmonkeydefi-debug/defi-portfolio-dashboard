# RPC endpoints — required for on-chain reads (LP analytics, AAVE, GMX, gas).
# These are normally set via Settings → RPC Endpoints in the UI, but you can also
# paste the full URL here. Free Alchemy or Infura keys work across all three chains.
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=

# Zerion — required. Unified EVM portfolio discovery (tokens, DeFi positions, lending).
# https://developers.zerion.io
ZERION_API_KEY=YOUR_ZERION_API_KEY

# Etherscan V2 — recommended. Single key works across Ethereum, Arbitrum, and Base.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# FRED — recommended for the AI Daily Brief macro section.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=YOUR_FRED_API_KEY

# AI Advisor — pick exactly one provider. All paid.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
