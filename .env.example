# RPC Endpoints
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Alchemy API Key (for NFT and token metadata)
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY

# Your wallet address(es) to track (comma-separated for multiple wallets)
# Example single wallet: WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS
# Example multiple wallets: WALLET_ADDRESS=0xWALLET1,0xWALLET2,0xWALLET3
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS

# Price API Keys (optional)
COINGECKO_API_KEY=YOUR_COINGECKO_API_KEY
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
DEFILLAMA_API_KEY=YOUR_DEFILLAMA_API_KEY

# Block Explorer API Keys (for historical event queries)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# Get free API keys at:
# Etherscan: https://etherscan.io/apis
# Arbiscan: https://arbiscan.io/apis  
# Basescan: https://basescan.org/apis
